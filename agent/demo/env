# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# RAPTOR Configuration
# For local LLM (Ollama), use available models: qwen3:0.6b, qwen3:8b, deepseek-coder:6.7b, llama3.1:latest
RAPTOR_MODEL=qwen3:8b
RAPTOR_BASE_URL=https://api.deepseek.com
# Local LLM configuration for RAPTOR
RAPTOR_USE_LOCAL_LLM=false
RAPTOR_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
RAPTOR_LOCAL_LLM_API_KEY=EMPTY
RAPTOR_EMBEDDING_MODEL=text-embedding-3-small
RAPTOR_MAX_TOKENS=2048
RAPTOR_TEMPERATURE=0.1
RAPTOR_CHUNK_SIZE=1000
RAPTOR_CHUNK_OVERLAP=200
RAPTOR_TREE_DEPTH=3
RAPTOR_SUMMARY_LENGTH=200

# GraphRAG Configuration
# For local LLM (Ollama), use available models: qwen3:0.6b, qwen3:8b, deepseek-coder:6.7b, llama3.1:latest
GRAPHRAG_MODEL=qwen3:8b
GRAPHRAG_BASE_URL=https://api.deepseek.com
# Local LLM configuration for GraphRAG
GRAPHRAG_USE_LOCAL_LLM=false
GRAPHRAG_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
GRAPHRAG_LOCAL_LLM_API_KEY=EMPTY
GRAPHRAG_EMBEDDING_MODEL=text-embedding-3-small
GRAPHRAG_CHUNK_SIZE=1200
GRAPHRAG_CHUNK_OVERLAP=100
GRAPHRAG_MAX_TRIPLES=10
GRAPHRAG_COMMUNITY_ALG=leiden
GRAPHRAG_SUMMARY_MODEL=qwen3:8b

# API Service Configuration
API_HOST=127.0.0.1
API_PORT=4242
API_RELOAD=true
API_MAX_RESULTS=10
API_TIMEOUT=30


# API Configuration
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Optional: LLM Provider Settings
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# System Hint Features (all default to true)
ENABLE_TIMESTAMPS=true
ENABLE_TOOL_COUNTER=true
ENABLE_TODO_LIST=true
ENABLE_DETAILED_ERRORS=true
ENABLE_SYSTEM_STATE=true

# Formatting Options
TIMESTAMP_FORMAT=%Y-%m-%d %H:%M:%S
SIMULATE_TIME_DELAY=false

# Execution Options
MAX_ITERATIONS=20
VERBOSE=false
COMMAND_TIMEOUT=30
