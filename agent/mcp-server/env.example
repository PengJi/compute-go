# MCP 天气服务器环境变量配置（open-meteo 版本）
# 复制此文件为 .env 并修改配置

# 注意：使用 open-meteo API，无需 API 密钥

# 服务器配置
LOG_LEVEL=INFO
CACHE_ENABLED=true

# 语言设置
DEFAULT_LANGUAGE=zh

# 缓存时间（秒）
CITY_COORDINATES_CACHE_TTL=86400  # 城市坐标缓存24小时
WEATHER_DATA_CACHE_TTL=900        # 天气数据缓存15分钟

# 请求限制（客户端限制）
REQUESTS_PER_MINUTE=60
REQUESTS_PER_HOUR=1000

# 调试模式
DEBUG=false

# 城市数据库
AUTO_UPDATE_CITIES=false
